# Dockerfile for safe guide testing
FROM ubuntu:latest

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential packages including python3-venv
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    python3-tk \
    curl \
    wget \
    sudo \
    git \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Create test user (not root for safety)
RUN useradd -m -s /bin/bash testuser && \
    echo 'testuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Set working directory
WORKDIR /app

# Copy requirements and create virtual environment
COPY requirements.txt .
RUN python3 -m venv /app/venv && \
    /app/venv/bin/pip install --upgrade pip && \
    /app/venv/bin/pip install -r requirements.txt

# Make sure virtual environment is activated for all users
ENV PATH="/app/venv/bin:$PATH"

# Switch to test user
USER testuser
WORKDIR /home/testuser/app

# Copy application files
COPY --chown=testuser:testuser . .

# Set environment variable for GUI
ENV DISPLAY=:0

# Default command
CMD ["python3", "main.py"]